#include <stdio.h>
#define DIM 8
#include <stdlib.h>
#include <time.h>

int main() {
	srand(time(NULL));

	int array[DIM], i = 0, j, conta;

	for(int i = 0; i < DIM; i++) {
			array[i] = rand() % 31;
	}

	for(int i = 0; i < DIM; i++) {
		conta = 0;
		for(int j = i; j < DIM; j++) {
			if(array[i] < array[j]) 
			conta++;
		}
	    if(conta == 0) printf("%d\t", array[i]);
	}

	return 0;
}
