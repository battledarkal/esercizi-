#include <stdio.h>
#define DIM 10


int main()
{

	int array[DIM], i, j, conta, numero, max = 0;

	for(int i = 0; i < DIM; i++) {
		printf("Inserisci il numero: ");
		scanf("%d", &array[i]);
	}

	for(int i = 0; i < DIM; i++) {
		conta = 0;
		for(int j = 0; j < DIM; j++) {
			if(array[i] == array[j]) conta++;
		}
		if(conta > max) {
			max = conta;
			numero = array[i];
		}
	}

	printf("Il numero comparso più volte è: %d", numero);

	return 0;
}
