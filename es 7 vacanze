#include <stdio.h>
#include <time.h>
#include <stdlib.h>
#define DIM 8

int main () {
    srand(time(NULL));

    int array[DIM], conta; doppioni = 0
 
    for(int i = 0; i < DIM; i++) {
    array[i] = rand() % 20;
    }

  for(int i = 0; i < DIM; i++) {
      conta = 0
      for(int j = 0; j < DIM; j++) {
        if(array[i] == array[j]) conta++;
      }
      if(conta > 1) doppioni = 1;
      if(doppioni == 0) printf("Tutti gli elementi sono diversi");
    }

  return 0;
  }
