#include <stdio.h>
int differenza(int a, int b, int c);

int main() {
    int num1, num2, num3;
    
    printf("Inserisci i primi 3 numeri: ");
    scanf("%d", &num1);
    scanf("%d", &num2);
    scanf("%d", &num3);
    
    printf("La differenza tra il prodotto è la somma dei tre numeri è: %d", differenza(num1, num2, num3));
}

int differenza(int a, int b, int c) {
    return (a * b* c) - (a + b + c);
}
 
