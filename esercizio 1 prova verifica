#include <stdio.h>
#define DIM 10

int main()
{
	int array[DIM], i, pari = 0, dispari = 0, somma = 0;

	for(int i = 0; i < DIM; i++) {
		printf("Inserisci il numero in posizione %d:  ", i);
		scanf("%d", &array[i]);
		if(array[i] % 2 == 0) {
            pari++;
		} else {
            dispari++;
		}
	}

printf("Ci sono %d elementi pari e %d elementi dispari\n", pari, dispari);


    for(int i = 0; i < DIM; i = i + 2){
        somma = somma + array[i];
    }

printf("La somma degli elementi che si trovano in posizioni di indice pari è %d", somma);

	return 0;
}
