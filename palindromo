#include <stdio.h>

int main() {

	int array[7] = {0}, i, conta = 0;

	for(int i = 0; i < 7; i++) {

		printf("inserisci un numero: ");
		scanf("%d", &array[i]);
	}

	for(int i = 0; i < 7/2; i++) {
		if(array[i] == array[6 - i]) conta++;
	}
	if(conta == 7/2) {
		printf("L'array è palindromo");
	} else {
		printf("L'array non è palindromo");

	}

	return 0;
}

