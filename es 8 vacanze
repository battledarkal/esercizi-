            conta = 0;
            	for(j = 0; j < i; j++) {
               		if(array[i] == array[j]) conta ++;
             	}
			if(conta == 0) {
				printf("%d", array[i]);
				i++;
				}
			}while(i < 18);
	
return 0;
}
